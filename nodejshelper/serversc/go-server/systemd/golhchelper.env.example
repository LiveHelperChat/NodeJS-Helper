# Configuration for golhchelper.service - install as /etc/golhchelper/golhchelper.env
#
#   sudo install -d -m 0750 /etc/golhchelper
#   sudo install -m 0640 -o root -g golhchelper \
#        systemd/golhchelper.env.example /etc/golhchelper/golhchelper.env
#   sudoedit /etc/golhchelper/golhchelper.env
#
# systemd `EnvironmentFile` syntax: one KEY=value per line, no `export`, no `$`
# interpolation (unlike compose's .env) - LHC secret hashes can be pasted as is. Wrap a
# value in double quotes when it contains `#` or a space. The file must exist, otherwise
# the unit refuses to start.

# REQUIRED - identical to `site.secrethash` in lhc_web/settings/settings.ini.php.
# The unit refuses to start while this still has the placeholder value.
SECRET_HASH=change-me-to-your-site-secrethash

# Recommended - fixed auth token signing key, so browser sessions survive a restart.
# Anything long and random works, e.g. `openssl rand -hex 32`. Must be identical on
# every node (see "Running several servers" in ../README.md).
AUTH_KEY=

# Port browsers/nginx connect to, and the websocket path. The health check script and
# nginx.conf assume 8000 unless changed here.
SOCKETCLUSTER_PORT=8000
SOCKETCLUSTER_PATH=/socketcluster/

# Allowed websocket origins, default is everything.
#ORIGINS=chat.example.com:443,chat.example.com:*

# How much is logged: debug, info (default), warn or error. `debug` adds one line per
# websocket connection (connected/disconnected) - helpful when chasing a client that
# reconnects in a loop, too noisy on a server holding thousands of sockets.
#LOG_LEVEL=info

# Visitor online tracking (mirrors `trackVisitors` from the old server.js).
#TRACK_VISITORS=true

# A visitor token is signed for one specific chat, so the socket may only subscribe
# to that chat's channel. Set to false only for a client that legitimately needs to
# use other chat channels - with it off any visitor can read any other visitor's
# chat (this was the old worker.js behaviour).
#STRICT_CHANNEL_BINDING=true

# Refuse `#publish` for channels the socket is not subscribed to. Off by default
# because SocketCluster's allowClientPublish was unrestricted.
#RESTRICT_CLIENT_PUBLISH=false

# Optional static files (replaces express' serve-static). Must be readable by the
# `golhchelper` user - the install steps use /srv/golhchelper/public.
#STATIC_DIR=/srv/golhchelper/public

# Redis. 127.0.0.1/6379 is the local Redis - no redis.conf change is needed, PHP, the
# server and Redis all talk over loopback.
# Keep in sync with `connect_db` in extension/nodejshelper/settings/settings.ini.php
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
#REDIS_PASS=
# Only for Redis 6+ ACL users, `default` is used otherwise.
#REDIS_USER=
#REDIS_DB=0

# Presence tracking and keep alive tuning.
#SC_INSTANCE_ID=                 # unique per node; leave unset (random per process)
#MAX_PAYLOAD=4194304            # 4 MiB
#SOCKET_CHANNEL_LIMIT=1000
#HANDSHAKE_TIMEOUT_MS=10000
# Outbound queue per websocket, in messages (~24 bytes per slot, so 256 is about
# 6 KB per connection). A socket that cannot drain it is closed with 1008.
#SOCKET_SEND_BUFFER=256

# Keep alive ping. Idle CPU is dominated by it; 15000 cut idle CPU by a factor of four in
# the load test (see "Load testing" in ../README.md). Must stay below PING_TIMEOUT_MS,
# which is also the delay clients notice a silently lost connection with.
#PING_INTERVAL_MS=15000
#PING_TIMEOUT_MS=20000
