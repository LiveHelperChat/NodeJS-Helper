# Copy to .env and adjust:  cp .env.example .env

# REQUIRED - must be identical to `site.secrethash` in lhc_web/settings/settings.ini.php
# (Settings -> Main -> Secret hash / or `secrethash` in the [site] section).
#
# SINGLE QUOTE IT when it contains `$` - Live Helper Chat hashes usually do. Compose
# interpolates `$` inside .env, which silently corrupts the value and makes every
# websocket login fail (you would also see 'The "xxxx" variable is not set' warnings):
#   SECRET_HASH='e9ekdkld4d0_D934-+_4535d_D9jasd@ASGFjkSDFfjksdffksdF456$#)8$asf931a171'
SECRET_HASH=change-me-to-your-site-secrethash

# Optional - fixed auth token signing key. Set it so browser sessions stay valid
# across restarts. Any long random string works, e.g. `openssl rand -hex 32`.
# Single quote it as well when it contains `$`.
#AUTH_KEY=

# Host port browsers connect to (container port stays 8000).
#SOCKETCLUSTER_PORT=8000

# --- Redis -------------------------------------------------------------------------
# docker-compose.yml (bundled Redis): the server always talks to the `redis` service;
# only its host port can be changed (it is published on 127.0.0.1).
#REDIS_PUBLISH_PORT=6379

# docker-compose.external-redis.yml (your own Redis): where that Redis lives.
# host.docker.internal = "this machine"; or use an IP / hostname.
# (docker-compose.host-network.yml uses 127.0.0.1 by default, no setting needed.)
# Keep in sync with `connect_db` in extension/nodejshelper/settings/settings.ini.php
#REDIS_HOST=host.docker.internal
#REDIS_PORT=6379
# Only when that Redis requires a password.
#REDIS_PASS=
#REDIS_DB=0

# Max memory for the bundled Redis (raise it if the instance is also used as LHC's cache).
#REDIS_MAXMEMORY=256mb

# Allowed websocket origins, default is everything. Example: "example.com:443,example.com:*"
#ORIGINS=*:*

# Visitor online tracking, mirrors `trackVisitors` from the old server.js
#TRACK_VISITORS=true
